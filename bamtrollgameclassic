-- 2. BIẾN TRẠNG THÁI & LƯU TÍNH NĂNG
local targetPlayer = nil
local lastAttacker = nil -- Lưu trữ kẻ vừa đánh mình
local isBamEnabled = false
local isXoayEnabled = false
local isAntiDmgEnabled = false
local isReturnToOldPos = true 

local originalCFrame = nil 
local lastHealth = 100
local isSafetyRetreating = false 

-- Hàm reset trạng thái khi Target thoát game
local function ResetTargetState()
    targetPlayer = nil
    isBamEnabled = false
    isXoayEnabled = false
    
    ToggleBamBtn.Text = "Bám: OFF"
    ToggleBamBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    
    ToggleXoayBtn.Text = "Xoay: OFF"
    ToggleXoayBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    
    if isReturnToOldPos and originalCFrame then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = originalCFrame
        end
    end
    originalCFrame = nil
end

-- Bắt sự kiện người chơi thoát game
Players.PlayerRemoving:Connect(function(player)
    if targetPlayer and player == targetPlayer then
        ResetTargetState()
    end
end)

-- Hàm cập nhật danh sách người chơi (ƯU TIÊN KẺ ĐÁNH MÌNH LÊN ĐẦU)
local function RefreshList()
    for _, child in pairs(ScrollFrame:GetChildren()) do 
        if child:IsA("TextButton") then child:Destroy() end 
    end
    
    local playerList = Players:GetPlayers()
    
    -- Lọc bỏ bản thân
    local filteredList = {}
    for _, p in pairs(playerList) do
        if p ~= LocalPlayer then
            table.insert(filteredList, p)
        end
    end
    
    -- Sắp xếp: Kẻ vừa đánh mình (lastAttacker) sẽ đứng đầu tiên
    table.sort(filteredList, function(a, b)
        if lastAttacker then
            if a == lastAttacker then return true end
            if b == lastAttacker then return false end
        end
        return a.Name < b.Name
    end)
    
    -- Hiển thị ra giao diện
    for _, player in pairs(filteredList) do
        local btn = Instance.new("TextButton", ScrollFrame)
        btn.Size = UDim2.new(0.92, 0, 0, 24)
        
        -- Nếu là kẻ vừa đánh mình thì đổi màu nền cam nổi bật
        if lastAttacker and player == lastAttacker then
            btn.Text = "⚡ " .. player.Name
            btn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
        else
            btn.Text = player.Name
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        end
        
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 12
        btn.Font = Enum.Font.SourceSans
        
        btn.MouseButton1Click:Connect(function() 
            targetPlayer = player 
            if not isBamEnabled then ToggleBamBtn.Text = "Bám: " .. player.Name end
            if not isXoayEnabled then ToggleXoayBtn.Text = "Xoay: " .. player.Name end
        end)
    end
end

task.spawn(function()
    while task.wait(2) do 
        RefreshList() 
    end 
end)

-- Hàm lưu và phục hồi vị trí cũ
local function SaveOrRestorePosition(enableState)
    local myChar = LocalPlayer.Character
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        if enableState then
            if not originalCFrame then
                originalCFrame = myChar.HumanoidRootPart.CFrame
            end
        else
            if not isBamEnabled and not isXoayEnabled then
                if isReturnToOldPos and originalCFrame then
                    myChar.HumanoidRootPart.CFrame = originalCFrame
                end
                originalCFrame = nil
            end
        end
    end
end

-- Bắt sự kiện Nút Bám
ToggleBamBtn.MouseButton1Click:Connect(function()
    if not targetPlayer then return end
    isBamEnabled = not isBamEnabled
    if isBamEnabled then isXoayEnabled = false end
    
    ToggleBamBtn.BackgroundColor3 = isBamEnabled and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    ToggleXoayBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    
    SaveOrRestorePosition(isBamEnabled)
    ToggleBamBtn.Text = isBamEnabled and ("Bám: " .. targetPlayer.Name) or ("Bám: OFF")
    if not isBamEnabled then ToggleXoayBtn.Text = "Xoay: OFF" end
end)

