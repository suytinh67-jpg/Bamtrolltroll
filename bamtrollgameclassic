-- 3. LOGIC DI CHUYỂN, PHÁT HIỆN SÁT THƯƠNG & NGƯỜI ĐÁNH
local orbitRadius = 4 

RunService.Stepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if myHum and myRoot then
        local currentHealth = myHum.Health
        
        -- KHI MẤT MÁU / DÍNH SÁT THƯƠNG
        if currentHealth < lastHealth then
            -- Tự động tìm xem người chơi nào đang ở gần mình nhất (kẻ đã gây sát thương)
            local closestDist = 20
            local attacker = nil
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (player.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        attacker = player
                    end
                end
            end
            
            -- Đẩy kẻ đánh mình lên vị trí đầu bảng
            if attacker then
                lastAttacker = attacker
                RefreshList()
            end
            
            -- Xử lý Chống Dính Sát Thương
            if isAntiDmgEnabled and (isBamEnabled or isXoayEnabled) and not isSafetyRetreating then
                isSafetyRetreating = true
                if originalCFrame then
                    myRoot.CFrame = originalCFrame
                end
                task.delay(1.5, function()
                    isSafetyRetreating = false
                end)
            end
        end
        lastHealth = currentHealth

        -- KIỂM TRA TARGET CÒN TRONG GAME / SỐNG KHÔNG
        if (isBamEnabled or isXoayEnabled) then
            if not targetPlayer or not targetPlayer.Parent or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                ResetTargetState()
                return
            end

            -- LOGIC BÁM HOẶC XOAY
            if not isSafetyRetreating then
                local targetRoot = targetPlayer.Character.HumanoidRootPart
                
                for _, part in pairs(myChar:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                
                if isBamEnabled then
                    local offset = 2.0 + (math.sin(os.clock() * 15) * 1.0)
                    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, offset)
                elseif isXoayEnabled then
                    local angle = os.clock() * (math.pi * 2) 
                    local offsetX = math.cos(angle) * orbitRadius
                    local offsetZ = math.sin(angle) * orbitRadius
                    local newPos = targetRoot.Position + Vector3.new(offsetX, 0, offsetZ)
                    myRoot.CFrame = CFrame.new(newPos, targetRoot.Position)
                end
            end
        end
    end
end)
